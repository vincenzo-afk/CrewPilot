# ---------------------------------------------------------------------------
# Switch server
# ---------------------------------------------------------------------------
# The agent bridge / API URL, not the Gateway UI. On a local Compose stack the
# API is published on port 8000.
SWITCH_API_URL=http://localhost:8000

# Filled automatically by:
#   python -m switch.register_agent --name crewpilot
# You can also set them manually if an admin gave you agent credentials.
SWITCH_AGENT_ID=
SWITCH_API_KEY=
SWITCH_AGENT_NAME=

# Used only by the registration command above, never by main.py.
SWITCH_REGISTRATION_TOKEN=

# ---------------------------------------------------------------------------
# AI brain: openai | anthropic
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai

OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# Only required when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Lifts GitHub API rate limits and allows triaging issues in private repos.
GITHUB_TOKEN=

LOG_LEVEL=INFO
